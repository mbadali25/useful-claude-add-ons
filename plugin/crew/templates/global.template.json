{
  "qa": {
    "provider": "auto",
    "order": [
      "codex",
      "kimi",
      "copilot",
      "claude"
    ],
    "fallback": "claude-sonnet-5",
    "codex": {
      "model": null,
      "reasoningEffort": null
    },
    "copilot": {
      "model": null
    },
    "kimi": {
      "model": null
    },
    "roles": {}
  },
  "dev": {
    "provider": "claude",
    "fallback": "claude-sonnet-5",
    "codex": {
      "model": null,
      "reasoningEffort": null
    },
    "copilot": {
      "model": null
    },
    "kimi": {
      "model": null
    },
    "roles": {}
  },
  "worktree": {
    "root": null
  },
  "secondOpinion": {
    "provider": "none",
    "mode": "cli",
    "model": null,
    "keyEnv": "GEMINI_API_KEY",
    "sendsCode": false
  },
  "memory": {
    "mode": "repo",
    "vaultPath": null
  },
  "notify": {
    "provider": "none",
    "urlEnv": null,
    "tokenEnv": null,
    "chatId": null,
    "events": [
      "phase",
      "gate",
      "waiting"
    ]
  },
  "pm": {
    "enabled": true,
    "mode": "adaptive",
    "quietLines": 8,
    "maxLines": 40,
    "authority": "report-only",
    "ticketGranularity": "system",
    "maxDispatches": 3
  },
  "context": {
    "autoClear": {
      "enabled": null,
      "method": "auto",
      "windowTitle": null,
      "command": "/clear",
      "delaySeconds": 3,
      "minHandoffLines": 5,
      "onlyRepos": null,
      "onlySessions": null
    }
  },
  "resume": {
    "auto": null
  },
  "docs": {
    "theme": null,
    "reportTheme": null
  },
  "bitbucket": {
    "mergeGate": {
      "enabled": false,
      "branch": null,
      "preset": "standard"
    }
  },
  "github": {
    "mergeGate": {
      "enabled": false,
      "branch": null
    }
  },
  "install": {
    "policy": "manual"
  },
  "guards": {
    "terraformApply": "block",
    "forcePush": "block",
    "adminMerge": "block",
    "mergeGate": "block",
    "cloudDestructive": "block",
    "sqlDestructive": "block",
    "prodDatabase": "none",
    "prodServer": "none",
    "roleWrites": "off",
    "cloudGuard": "off"
