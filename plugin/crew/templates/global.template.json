  "route": {
    "enabled": false
  },
  "shellRoute": {
    "mode": "auto",
    "distro": null
  },
  "unattendedCloud": {
    "aws": {
      "readOnly": {
        "profile": null,
        "identity": null,
        "region": null
      },
      "nonProd": {}
    }
  }
