{
  "hooks": {
    "SessionStart": [
      { "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" SessionStart", "timeout": 30}] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" UserPromptSubmit", "timeout": 30}] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" PreToolUse", "timeout": 30}] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit|mcp__.*(obsidian|vault|basic[-_]memory).*",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" PostToolUse", "timeout": 20}] }
    ],
    "SubagentStart": [
      { "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" SubagentStart", "timeout": 25}] }
    ],
    "PreCompact": [
      { "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" PreCompact", "timeout": 40}] }
    ],
    "Notification": [
      { "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" Notification", "timeout": 25}] }
    ],
    "Stop": [
      { "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-hook.sh\" Stop", "timeout": 610}] }
    ]
  }
}
