{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff-read.sh\"", "timeout": 15 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff-read.ps1\"; exit $LASTEXITCODE", "timeout": 15 }] },
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/platform-sync.sh\"", "timeout": 20 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/platform-sync.ps1\"; exit $LASTEXITCODE", "timeout": 20 }] },
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.sh\"", "timeout": 20 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.ps1\"; exit $LASTEXITCODE", "timeout": 20 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.sh\"", "timeout": 15 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.ps1\"; exit $LASTEXITCODE", "timeout": 15 }] },
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/approval-hook.sh\"", "timeout": 20 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/approval-hook.ps1\"; exit $LASTEXITCODE", "timeout": 20 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/promote-gate.sh\"", "timeout": 20 }] },
      { "matcher": "PowerShell",
        "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/promote-gate.ps1\"; exit $LASTEXITCODE", "timeout": 20 }] },
      { "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/role-write-guard.sh\"", "timeout": 10 }] },
      { "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/role-write-guard.ps1\"; exit $LASTEXITCODE", "timeout": 10 }] },
      { "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/cloud-guard.sh\"", "timeout": 15 }] },
      { "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/cloud-guard.ps1\"; exit $LASTEXITCODE", "timeout": 15 }] },
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scope-guard.sh\"", "timeout": 15 }] },
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scope-guard.ps1\"; exit $LASTEXITCODE", "timeout": 15 }] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.sh\"", "timeout": 10 }] },
      { "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.ps1\"; exit $LASTEXITCODE", "timeout": 10 }] },
      { "matcher": "mcp__.*(obsidian|vault|basic[-_]memory).*",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.sh\"", "timeout": 10 }] },
      { "matcher": "mcp__.*(obsidian|vault|basic[-_]memory).*",
        "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.ps1\"; exit $LASTEXITCODE", "timeout": 10 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.sh\"", "timeout": 15 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/crew-context.ps1\"; exit $LASTEXITCODE", "timeout": 15 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff-write.sh\"", "timeout": 30 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff-write.ps1\"; exit $LASTEXITCODE", "timeout": 30 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify.sh\" waiting 'Claude is waiting on you'", "timeout": 15 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify.ps1\" waiting 'Claude is waiting on you'; exit $LASTEXITCODE", "timeout": 15 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/verify-gate.sh\"", "timeout": 600 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/verify-gate.ps1\"; exit $LASTEXITCODE", "timeout": 600 }] },
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/context-watch.sh\"", "timeout": 20 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/context-watch.ps1\"; exit $LASTEXITCODE", "timeout": 20 }] },
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/completion-audit.sh\"", "timeout": 60 }] },
      { "hooks": [{ "type": "command", "shell": "powershell", "command": "& \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/completion-audit.ps1\"; exit $LASTEXITCODE", "timeout": 60 }] }
    ]
  }
}
