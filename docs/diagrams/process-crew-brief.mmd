        stale -- yes --> arch["archive to .crew/handoffs/<br/>never delete<br/>crew_state.py:774, :980"]
        stale -- no --> cc6
        arch --> cc6
        stale -. "stale but the move failed:<br/>note stays, stale passed on (:828)" .-> cc6
        cc6{"auto-resume armed?<br/>machine resume.auto true, no repo veto<br/>source clear / manual compact<br/>:835, crew_resume.decide"}
        cc6 -- "no (off)" --> src{"source?"}
        cc6 -- "run / wait" --> rs1["one line: ready to run the re-rendered command,<br/>or did not start: reason<br/>resume_line :653, never initialUserMessage"]
        rs1 --> src
