flowchart TB
    ask([A request])
    ask --> small{"small? one subsystem, known cause,<br/>no new behaviour, no auth/SQL/IaC<br/>brainstorm.md:90-91"}
    small -- yes --> fix["/crew:fix - same phases,<br/>one step each, one review round<br/>fix.md:2, :75, :95"]
    small -- no --> BR

    subgraph brainstorm["/crew:brainstorm"]
        BR["mint T-####: crew_tracker.py create<br/>INDEX row 'direction' (+ Obsidian card);<br/>'id taken' -> next free id;<br/>any other failure -> stop<br/>brainstorm.md:15-40"] --> br2["one question per message,<br/>then 2-3 options, recommendation first<br/>:45, :54"]
        br2 --> br3["write direction.md, show, STOP<br/>:63-73"]
    end

    br3 --> ok1{user approves<br/>the direction?}
    ok1 -- no --> br2
    ok1 -- yes --> rdy["crew_tracker.py move --to ready<br/>(INDEX 'ready', card stays in Backlog)<br/>brainstorm.md:81"]

    subgraph spec["/crew:spec"]
        rdy --> sp1{"direction.md?<br/>spec.md:10"}
        sp1 -- missing --> spx([refuse: run /crew:brainstorm])
        sp1 -- yes --> sp2["write spec.md: Intent, Exclusions, Evidence,<br/>Unknowns, Touch, Acceptance checks<br/>:15; Touch one path per bullet :38-43"]
        sp2 --> sp3["crew_tracker.py move --to spec<br/>(INDEX, board -> Ready)<br/>:45-48"]
    end

    subgraph plan["/crew:plan"]
        sp3 --> pl1["write plan.md: steps with Files / Test / Risk / Standards<br/>plan.md:27, :36; optional second opinion :22"]
        pl1 --> pl2{"every Files: entry<br/>inside Touch?<br/>:44"}
        pl2 -- no --> amend["amend spec Touch first<br/>spec.md:57"]
        amend --> pl1
        pl2 -- yes --> pl3["show the plan, STOP<br/>:49"]
    end

    subgraph approve["/crew:approve - typed by the user only"]
        pl3 --> ap0["user types /crew:approve id<br/>approve.md:5 disable-model-invocation"]
        ap0 --> ap1{"approval-hook (UserPromptSubmit)<br/>hooks.json:14; approve.md:9"}
        ap1 -- refused --> apx([prompt blocked, reason shown<br/>:15])
        ap1 -- recorded --> ap2["approval.json = digest(spec.md, plan.md),<br/>header status value normalised<br/>approved_via user-prompt<br/>:12-13"]
        ap1 -- "several ids, a range,<br/>or plain text" --> apg["PENDING list, nothing recorded;<br/>user's own /crew:approve --confirm<br/>records one receipt per ticket, or none<br/>approve.md:27-32"]
        apg -- "confirmed, every hash unchanged" --> ap2
    end

    ap2 --> planned["spec.md header 'status: planned'<br/>keeps the approval,<br/>crew_tracker.py move --to planned<br/>plan.md:60-63"]

    subgraph implement["/crew:implement"]
        planned --> im0{"crew_ticket.py validate:<br/>plan approved?<br/>implement.md:17-23"}
        im0 -- "no / stale" --> imx([refuse: /crew:plan id --approve])
        im0 -- yes --> im1["scope_base --record, then<br/>crew_tracker.py move --to in-progress<br/>:28, :33"]
        im1 --> im2["recurring-findings checklist<br/>for the Touch paths, then<br/>steps in order, test first<br/>:38-42; scope-guard on every write<br/>hooks.json:31 (PreToolUse, Touch)"]
        im2 --> im3a["changed-file list, verify<br/>:59, :69"]
        im3a --> im3["step 6: tests, then /crew:docs<br/>:88-91"]
        im3 --> rf1{"crew_refresh_check.py<br/>:94"}
        rf1 -- "refresh with ..." --> rf2["run the named refresh,<br/>commit, re-run"]
        rf2 --> rf1
        rf1 -- "stop" --> rfx([report the reason, stop])
        rf1 -- fresh --> sc1["required standards self-check:<br/>crew_standards.py init, answer every row,<br/>crew_standards.py stamp until exit 0<br/>:106-110"]
        sc1 --> im4["spec.md header 'status: review'<br/>(keeps the approval),<br/>crew_tracker.py move --to review<br/>(Review lane: review outstanding)<br/>:111-114"]
        im4 --> im5["then /crew:review last<br/>:115"]
    end

    subgraph review["/crew:review - two rounds per ticket"]
        im5 --> pf0{"preflight first (#264):<br/>a CLEAN receipt covers this bundle?<br/>verify gate passed this tree?<br/>review_run.py:672, :846"}
        pf0 -- "CLEAN receipt: CLEAN,<br/>no round, no self-check" --> rcpt
        pf0 -- "gate not passed or unknown:<br/>exit 5, no round spent,<br/>self-check not asked<br/>review.md:449" --> vg0["run the verify gate,<br/>then review again"]
        vg0 --> im5
        pf0 -- "go on" --> pr0{"pre-review checks (L-0574):<br/>no linter finding the bundle adds<br/>against its base? could every<br/>configured linter check?<br/>review_run.py prereview_gate :731"}
        pr0 -- "NEW finding: exit 5, no round spent,<br/>not overridable; or COULD NOT CHECK:<br/>exit 5 unless --allow-unverified<br/>review.md:449" --> fx0["fix the finding or the tool,<br/>then review again"]
        fx0 --> im5
        pr0 -- "pass / n/a / none configured,<br/>override recorded, or an active<br/>incident (skip logged)" --> rv0{"self-check stamped for<br/>this bundle and standards set?<br/>review_run.py standards_gate"}
        pf0 -- "no rounds left or NEEDS_REPLAN:<br/>the budget refusal answers first,<br/>no pre-review checks, no self-check<br/>review_run.py:850-861" --> replan
        rv0 -- "no: exit 2,<br/>no round spent<br/>review.md:446-449" --> sc1
        rv0 -- "yes (or no approval receipt,<br/>or an incident: skip logged)" --> rv1["reserve a round, run Codex / Copilot /<br/>crew:reviewer fallback on one bundle;<br/>prompt carries the standards checklist,<br/>then the recurring-findings checklist,<br/>then any web tests<br/>review.md:25-28, :451"]
        rv1 --> rv2{"verdict (the script's)<br/>:440, :482-486"}
        rv2 -- "CLEAN (exact: no other line)" --> rcpt["receipt written<br/>:510"]
        rv2 -- "FINDINGS (stray prose beside findings<br/>ignored and named: review_verdict.py:210-213)" --> rv3{"report findings and every<br/>ignored line verbatim (:498-500);<br/>final round, 0 BLOCK?<br/>else fix, or the<br/>owner accepts<br/>:503, :505-508"}
        rv3 -- "auto-accept (L-0510): eligible,<br/>no specialist/control BLOCK;<br/>one follow-up ticket :505-506<br/>- or the owner accepts :508" --> rcpt
        rv3 -- "fix, round 2" --> rv1
        rv2 -- "INCOMPLETE (tool failure: refunded, :485-486)" --> rv1
        rv2 -- "INCOMPLETE (reviewer / tree, a contract-like<br/>or shortfall stray line): counts" --> rv1
        rv2 -- "third round refused" --> replan([NEEDS_REPLAN:<br/>back to /crew:plan])
    end


    subgraph done["/crew:done - all four or nothing<br/>done.md:7"]
        rcpt --> dn1{"1 review receipt<br/>--check-receipt<br/>done.md:10-13"}
        dn1 -- pass --> dn2{"2 verify gate all pass<br/>crew_status.py<br/>:21-27"}
        dn2 -- pass --> dn3{"3 completion audit<br/>(refresh artifacts: re-anchor or<br/>regeneration the change reaches)<br/>:40-53"}
        dn3 -- pass --> dn5{"4 artifacts current<br/>crew_refresh_check.py, read-only<br/>:55-66"}
        dn5 -- fresh --> dnr["report, never a check:<br/>crew_trailers.py --check<br/>git.forbiddenTrailers over the ticket's commits,<br/>copied to close note + PR body; no rewrite<br/>:68-79"]
        dnr --> dn4["spec.md 'status: done' (keeps the approval),<br/>crew_tracker.py move --to done,<br/>crew_metrics record<br/>:80-97"]
        dn1 -- fail --> dnx([refuse done])
        dn2 -- fail --> dnx
        dn3 -- fail --> dnx
        dn5 -- "stale / unknown" --> dnx
        dn4 --> ln0{"train armed?<br/>crew_train.py status<br/>done.md:99-102"}
        ln0 -- yes --> ln1{"crew_train.py check-land:<br/>holds the train, merge-tree clean,<br/>base unmoved in Touch, receipt + gate<br/>done.md:104-110"}
        ln1 -- LAND_OK --> ln2["you run the printed gh pr merge<br/>--merge --match-head-commit sha;<br/>then release --merged sha<br/>(crew never merges) :110-111"]
        ln1 -- "refused: catch-up,<br/>gate the merged head again<br/>:112-113" --> im5
    end

    fix -.-> BR
    fix -. "same /crew:approve,<br/>/crew:review, /crew:done" .-> ap0

    stop["Stop hooks every turn:<br/>verify-gate, completion-audit<br/>hooks.json:58, :62"] -.- im2
