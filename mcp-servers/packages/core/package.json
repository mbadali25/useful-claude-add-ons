{
  "name": "@mbadali/mcp-ms-core",
  "version": "0.1.0",
  "description": "Shared auth, HTTP, and write-gate helpers for the Microsoft MCP server family (Graph, Intune, Office 365 user/admin)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@azure/identity": "^4.13.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  },
  "engines": {
    "node": ">=18"
  }
}
