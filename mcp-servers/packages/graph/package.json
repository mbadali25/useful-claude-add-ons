{
  "name": "@mbadali/mcp-msgraph",
  "version": "0.1.0",
  "description": "MCP server for Microsoft Graph directory data (users, groups) -- app-only, tenant-wide",
  "type": "module",
  "bin": {
    "mcp-msgraph": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('fs').chmodSync('dist/src/cli.js',0o755)}catch(e){}\"",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@mbadali/mcp-ms-core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  },
  "engines": {
    "node": ">=18"
  }
}
