# Pylint configuration for useful-claude-add-ons.
#
# This repo is not a Python package. It's ~20 independent Claude Code skills,
# each shipping standalone helper scripts that Claude runs directly. Default
# pylint assumes a library with installed dependencies, so a few of its checks
# fight the design rather than finding bugs. Those are disabled below, each with
# the reason. Everything else -- including every E-class check -- stays on.
#
# Run locally exactly as CI does:
#   pip install 'pylint~=4.0'
#   pylint $(git ls-files '*.py')

[MAIN]
# Optional third-party deps. Skill scripts import these lazily and degrade
# gracefully when they're absent (see e.g. visio-diagrams' ensure_deps.py), so
# CI deliberately does not install them -- there's nothing to pin, and each
# skill's docs cover its own setup. Without this, E0401 fires on code paths
# that are correct by design.
#
# This is the complete set of third-party imports in the repo. Regenerate it
# after adding a skill that takes a new dependency -- if you only test where
# the package happens to be installed, the gap shows up as a CI-only failure:
#
#   python - <<'PY'
#   import ast, subprocess, sys, pathlib
#   files = subprocess.run(["git","ls-files","*.py"], capture_output=True,
#                          text=True).stdout.split()
#   local = {pathlib.Path(f).stem for f in files}
#   mods = set()
#   for f in files:
#       for n in ast.walk(ast.parse(open(f, encoding="utf-8").read())):
#           if isinstance(n, ast.Import):
#               mods |= {a.name.split(".")[0] for a in n.names}
#           elif isinstance(n, ast.ImportFrom) and n.level == 0 and n.module:
#               mods.add(n.module.split(".")[0])
#   print(sorted(mods - set(sys.stdlib_module_names) - local))
#   PY
#
# Both the bare name and the `.*` glob are listed so submodule imports
# (reportlab.platypus, urllib3.exceptions) are covered too.
ignored-modules=botocore,botocore.*,conftest,fcntl,mcp,mcp.*,msvcrt,
                numpy,numpy.*,playwright,playwright.*,pytest,pytest.*,
                reportlab,reportlab.*,requests,requests.*,urllib3,urllib3.*,
                vsdx,vsdx.*,weasyprint,weasyprint.*,yaml,yaml.*
# `mcp` and `numpy` arrived with the localgpu plugin and are exactly the
# CI-only failure the regeneration script above warns about: both are installed
# in localgpu's own venv, so a local run is clean while CI - which deliberately
# installs no third-party deps - reports E0401 on correct code.
#
# `conftest` is not third-party at all - it is listed because pylint cannot
# resolve it correctly here and never will. The repo has two conftest.py
# (plugin/crew/tests/ and plugin/localgpu/mcp/_test/), neither in a package, so
# the bare name is ambiguous: pylint binds `from conftest import TEST_DIM` to
# whichever it reaches first and then reports the symbol missing. pytest has no
# such problem - it resolves conftest by directory, which is why every one of
# these suites passes while only the linter objects. Suppressing resolution is
# honest about that; per-file disables would need adding to every new test.
#
# `msvcrt` and `fcntl` are the subtle pair and the script above cannot find
# either. Both are stdlib, but each on only ONE platform: store.py imports
# msvcrt on Windows and fcntl on POSIX, inside a platform branch, for the same
# file lock. `sys.stdlib_module_names` reflects the interpreter running the
# script, so a Windows run filters out msvcrt and reports fcntl, and a Linux
# run does the exact opposite. Whichever machine you regenerate on, you get
# half the answer and CI fails on the other half. Both belong here
# permanently, and any future platform-conditional stdlib import (winreg,
# termios, msilib) needs adding by hand for the same reason.

[FORMAT]
# 100 is tight for scripts that embed XML/SQL/URL literals which can't wrap.
max-line-length=120

# ticketctl.py is one file on purpose -- a skill script has to be runnable on
# its own, so it can't import sibling modules that may not be copied with it.
# Raised from 2000 when update/close were added for both providers; the limit
# tracks that constraint rather than expressing a target.
#
# Raised again to 3300 on 2026-09-06 for the endpoint ledger, which took
# `crew_state.py` from 2154 to 3283 lines in a single branch. Recording the
# number honestly rather than quietly: a 52% growth in one module is a real
# signal that it is doing too much, and raising a lint ceiling is not a fix for
# that. `TODO.md` carries the split as its own item. If this line needs raising
# a third time, split the module instead.
max-module-lines=3300

[MESSAGES CONTROL]
disable=
    # --- Docstrings -------------------------------------------------------
    # Skills document themselves in SKILL.md and references/, which is what
    # Claude actually reads. Requiring a docstring on every argparse handler
    # would add ~400 lines of noise that duplicates the skill docs.
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,

    # --- Design metrics ---------------------------------------------------
    # These measure shape, not correctness. A single-file API client with one
    # argparse dispatcher legitimately has many short methods and a long main().
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-statements,
    too-many-branches,
    too-many-return-statements,
    too-many-instance-attributes,
    too-many-public-methods,
    too-few-public-methods,
    too-many-nested-blocks,

    # Each skill is deliberately self-contained and copy-pasteable -- shared
    # auth/retry scaffolding across skills is the point, not duplication to
    # factor out. Cross-file R0801 flags exactly that on-purpose overlap.
    duplicate-code,

    # --- Idioms this codebase uses on purpose -----------------------------
    # Optional deps are imported at the call site so a missing package
    # degrades one subcommand instead of failing the whole script at import.
    import-outside-toplevel,
    # localgpu's mcp/ and cli/ are flat sibling modules, not a package: both
    # the MCP server and the CLI put their own directory on sys.path and then
    # import `config`, `store`, `indexer` by bare name. The sys.path line has
    # to run BEFORE those imports, so they are legitimately not at the top --
    # the same reason each already carries `# noqa: E402` for flake8. Moving
    # them up makes the modules unimportable.
    wrong-import-position,
    # argparse handlers share one (client, args) signature for uniform
    # dispatch; some don't need args.
    unused-argument,
    # CLI entry points catch broadly on purpose, to print a clean message
    # instead of a traceback.
    broad-exception-caught,
    # Tests reach into internals to assert on them.
    protected-access,
    # `assert hits == []` says more than `assert not hits`: it pins the type as
    # well as the emptiness, so a function that starts returning None or 0
    # fails the test instead of silently satisfying it. In assertions the
    # explicit comparison is the stronger check, not a verbose one.
    use-implicit-booleaness-not-comparison,
    # How pytest fixtures work, not a mistake. A test that consumes a fixture
    # takes a parameter with the fixture function's own name -- that IS the
    # wiring -- so every fixture-consuming test in the repo reports this once
    # per parameter. Renaming to silence it would break the injection.
    redefined-outer-name,

    # --- Pure style -------------------------------------------------------
    # Short-lived script locals (fh, k, v, ns) read fine.
    invalid-name,
    multiple-statements,
