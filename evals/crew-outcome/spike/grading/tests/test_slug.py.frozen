import os
import sys

import pytest

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from slug import slugify, titlecase


def test_titlecase():
    assert titlecase("hello big world") == "Hello Big World"


def test_slugify_basic():
    assert slugify("Hello, World!") == "hello-world"


def test_slugify_collapses_runs():
    assert slugify("a  --  b") == "a-b"


def test_slugify_strips_hyphens():
    assert slugify("--x--") == "x"


def test_slugify_empty():
    assert slugify("") == ""


def test_slugify_non_ascii_is_a_separator():
    assert slugify("Café 42") == "caf-42"


@pytest.mark.parametrize("value", [None, 3, b"x", ["a"]])
def test_slugify_rejects_non_str(value):
    with pytest.raises(TypeError):
        slugify(value)
